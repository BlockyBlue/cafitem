          const rawDate = document.getElementById('date').value.trim() || new Date().toISOString().substring(0,16);
          const location = document.getElementById('location').value.trim();
          const travel = parseFloat(document.getElementById('travel').value) || 0;
          const deposit = parseFloat(document.getElementById('deposit').value) || 0;
          const discount = parseFloat(document.getElementById('discount').value) || 0;
          const tax = parseFloat(document.getElementById('tax').value) || 0;

          const adultQty = parseFloat(document.getElementById('adultQty').value) || 0;
          const adultPrice = parseFloat(document.getElementById('adultPrice').value) || 0;
          const kidQty = parseFloat(document.getElementById('kidQty').value) || 0;
          const kidPrice = parseFloat(document.getElementById('kidPrice').value) || 0;
          const deluxeQty = parseFloat(document.getElementById('deluxeQty').value) || 0;
          const deluxePrice = parseFloat(document.getElementById('deluxePrice').value) || 0;
          const setupFeePrice = parseFloat(document.getElementById('setupFeePrice').value) || 0;
          const upgradePrice = parseFloat(document.getElementById('upgradePrice').value) || 0;
          const itemsText = (document.getElementById('items-input') ? document.getElementById('items-input').value : '') || '';
          const itemsPrice = parseFloat(document.getElementById('items-input-price').value) || 0;

          let itemsRowsTotal = 0;
          document.querySelectorAll('.item-row').forEach(r => {
            const qty = parseFloat(r.querySelector('.quantity-input').value) || 0;
            const price = parseFloat(r.querySelector('.item-price-input').value) || 0;
            if (qty && price) itemsRowsTotal += qty * price;
          });

          const foodSubtotal = (adultQty * adultPrice) + (kidQty * kidPrice) + (deluxeQty * deluxePrice) + setupFeePrice + upgradePrice + itemsPrice + itemsRowsTotal;
          const taxAmount = foodSubtotal * (tax / 100);
          const grandTotal = foodSubtotal + travel + taxAmount;
          const balance = grandTotal - deposit - discount;

          const lineItems = {
            adults: { quantity: adultQty, price: adultPrice },
            kids: { quantity: kidQty, price: kidPrice },
            deluxe: { quantity: deluxeQty, price: deluxePrice },
            upgrade: { price: upgradePrice },
            setup: { price: setupFeePrice },
            items: { price: itemsPrice + itemsRowsTotal, text: itemsText },
            travel: { price: travel }
          };

          const updatedData = {
            date: rawDate,
            location,
            lineItems,
            taxRate: tax,
            deposit,
            discount,
            total: grandTotal,
            balance
          };

          await updateDoc(invoiceDocRef, updatedData);
          showMessage('Invoice updated successfully');
        } catch (err) {
          console.error('Error updating invoice:', err);
          showMessage('Error updating invoice. See console.');
        }
      };

    window.addEventListener('DOMContentLoaded', () => {
      adultsContainer = document.getElementById('adults-items');
      kidsContainer   = document.getElementById('kids-items');
      deluxeContainer = document.getElementById('deluxe-items');
        // Initialize Firebase (so new/update invoice endpoints work)
      initFirebase();

      const savedInvoice = sessionStorage.getItem('invoiceForCalculator');
      if (savedInvoice) {
        const invoiceData = JSON.parse(savedInvoice);
        // Save current document id (if provided) so updateInvoice knows which doc to update
        window.currentInvoiceDocId = invoiceData.docId || null;

       document.getElementById('date').value = invoiceData.date;
       document.getElementById('location').value = invoiceData.location;
       document.getElementById('travel').value = invoiceData.travel;
       document.getElementById('deposit').value = invoiceData.deposit;
       document.getElementById('discount').value = invoiceData.discount;
       document.getElementById('tax').value = invoiceData.tax;

       document.getElementById('adultQty').value = invoiceData.adults.quantity;
       document.getElementById('adultPrice').value = invoiceData.adults.price;
       document.getElementById('kidQty').value = invoiceData.kids.quantity;
       document.getElementById('kidPrice').value = invoiceData.kids.price;
       document.getElementById('deluxeQty').value = invoiceData.deluxe.quantity;
       document.getElementById('deluxePrice').value = invoiceData.deluxe.price;

        document.getElementById('setupFeePrice').value = invoiceData.setup.price;
       document.getElementById('upgradePrice').value = invoiceData.upgrade.price;
       if (document.getElementById('items-input')) document.getElementById('items-input').value = (invoiceData.items && invoiceData.items.text) || '';
       if (document.getElementById('items-input-price')) document.getElementById('items-input-price').value = (invoiceData.items && invoiceData.items.price) || 0;

        // Seed dynamic item rows from session data if present
        try {
          const itemsText = (invoiceData.items && invoiceData.items.text) || '';
          if (itemsText) seedItemRowsFromItemsText(itemsText);
        } catch (err) {
          console.warn('Error seeding item rows from session invoice:', err);
        }

const rawDate = document.getElementById('date').value;
let formattedDate = rawDate;

if (rawDate) {
  const d = new Date(rawDate);
  const months = [
    "January","February","March","April","May","June",
    "July","August","September","October","November","December"
  ];

  let hours = d.getHours();
  const minutes = d.getMinutes();
  const ampm = hours >= 12 ? "PM" : "AM";
  hours = hours % 12;
  hours = hours ? hours : 12; // 0 → 12

  formattedDate = `${months[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()} at ${hours}:${minutes} ${ampm}`;
  document.getElementById('date').value = formattedDate;
}
      }
      
      // Expose functions used by inline `onclick` attributes (module scope is not global)
      window.newInvoice = newInvoice;
      window.updateInvoice = updateInvoice;
      window.showModify = showModify;
      window.hideModify = hideModify;
      window.showAutofill = showAutofill;
      window.hideAutofill = hideAutofill;
      window.showInvoicePicker = showInvoicePicker;
      window.hideInvoicePicker = hideInvoicePicker;
      window.addItem = addItem;
      window.handleUpdateClick = handleUpdateClick;
      window.restoreFallback = restoreFallback;
      window.copyInvoice = copyInvoice;
      window.printInvoice = printInvoice;
      window.clearAll = clearAll;

      loadItems();
      loadInvoiceSettings();
      // Only create a blank item row if none were seeded from session/load
      if (document.querySelectorAll('.item-row').length === 0) createItemRow();
      generateInvoice();
      const refreshBtn = document.getElementById('refreshInvoiceList');
      if (refreshBtn) refreshBtn.addEventListener('click', populateInvoicePicker);
    });
  </script>
  </div>
</Layout>